# PostgreSQL hostname (Docker Compose uses the db service name).
DB_HOST=db
# Optional full PostgreSQL URI; leave empty to use DB_HOST and DB_*.
DATABASE_URL=
# PostgreSQL port inside the Compose network.
DB_PORT=5432
# PostgreSQL database name.
DB_NAME=smartcrm_l4_workshop
# PostgreSQL login user.
DB_USER=postgres
# Local-only sample password; replace before any public deployment.
DB_PASSWORD=change_me_locally
# Published API port on the host machine.
APP_PORT=3000
# Optional port override for direct hosting outside Docker Compose.
PORT=
# Bootstrap demo account username.
AUTH_BOOTSTRAP_USERNAME=manager
# Bootstrap demo account password; replace with a unique value.
AUTH_BOOTSTRAP_PASSWORD=change_me_to_a_unique_12_char_password
# Display name for the bootstrap demo account.
AUTH_BOOTSTRAP_DISPLAY_NAME=Demo Manager
# Set true only when serving the application over HTTPS.
AUTH_COOKIE_SECURE=false
# Vite API base path for local frontend development.
VITE_API_BASE_URL=/api
# Local Vite proxy target when running the API outside Compose.
VITE_API_PROXY_TARGET=http://localhost:3000
