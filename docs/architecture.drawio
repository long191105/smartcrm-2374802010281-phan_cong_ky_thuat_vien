        <mxCell id="n28" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F3E5F5;strokeColor=#6A1B9A;strokeWidth=2;fontSize=13;" value="&lt;b&gt;LỚP 4 · LƯU TRỮ (Repository + PostgreSQL)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;Trách nhiệm: đọc/ghi dữ liệu; bảo vệ toàn vẹn bằng PK, FK, UNIQUE, CHECK, EXCLUDE và index (NFR1, NFR2).&lt;/i&gt;" vertex="1">
