        <mxCell id="n30" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FFFFFF;strokeColor=#6A1B9A;fontSize=11;verticalAlign=middle;" value="&lt;b&gt;CSDL PostgreSQL – 6 bảng lõi&lt;/b&gt;&lt;br&gt;ticket · technician · technician_skill · appointment · ticket_assignment · ticket_status_log&lt;br&gt;&lt;br&gt;&lt;b&gt;Bảng tham chiếu (L2/phụ trợ):&lt;/b&gt;&lt;br&gt;customer · device · service_center · employee · issue_category" vertex="1">
