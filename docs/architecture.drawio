        <mxCell id="n11" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;" value="&lt;b&gt;Sơ đồ kiến trúc 4 lớp – L4 Phân công kỹ thuật viên và lịch hẹn&lt;/b&gt;" vertex="1">
