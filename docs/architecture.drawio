        <mxCell id="n22" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFF8E1;strokeColor=#B8860B;strokeWidth=2;fontSize=13;" value="&lt;b&gt;LỚP 3 · NGHIỆP VỤ (Service)&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px&quot;&gt;Trách nhiệm: TOÀN BỘ quy tắc nghiệp vụ (QT-06, QT-07, QT-08…), mở giao dịch, gọi Repository.&lt;/i&gt;" vertex="1">
